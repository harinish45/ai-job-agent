# ==============================================================================
# AI Job Application Agent - Environment Configuration
# ==============================================================================

# LLM Provider Options: mock, openai, gemini
LLM_PROVIDER=mock

# OpenAI API Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview

# Google Gemini API Configuration
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# Application Tracker Settings
APPLICATIONS_DB_PATH=applications.db
MIN_ATS_MATCH_SCORE=70.0

# Browser Automation (Playwright) Settings
HEADLESS=true
BROWSER_TIMEOUT_MS=30000
AUTO_APPLY_DRY_RUN=true
AUTO_APPLY_DELAY_SECS=3

# Full-Stack & Docker Deployment Settings
DATABASE_URL=postgresql://jobagent:jobagent_secret@localhost:5432/jobagent
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=change-this-to-a-secure-random-jwt-secret-key-32-chars
ENCRYPTION_KEY=change-this-to-a-32-byte-fernet-key-base64==
